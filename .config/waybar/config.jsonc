{
  // Waybar at top layer
  "layer": "top",

  // Waybar position (top|bottom|left|right)
  "position": "top",

  "margin": "10 250 0 250",

  // Choose the order of the modules
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/language",
    "hyprland/submap",
  ],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "custom/mem", "cpu", "tray"],

  //***************************
  //*  Modules configuration  *
  //***************************

  // "custom/perplex": {
  //   "format": "perp",
  //   "tooltip": false,
  //   "on-click": "firefox https://www.perplexity.ai/",
  // },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
    },
    "persistent-workspaces": {
      "*": 5,
    },

    "justify": "center",
    "disable-scroll": true,
  },

  "hyprland/window": {
    "max-length": 35,
    "format": "{class}",
    "tooltip-format": "{title}",
    "separate-outputs": true,
  },

  "hyprland/language": {
    "format-en": "US",
    "format-ru": "RU",
    "min-length": 5,
    "tooltip": false,
  },

  "keyboard-state": {
    //"numlock": true,
    "capslock": true,
    "format": "{icon} ",
    "format-icons": {
      "locked": "",
      "unlocked": "",
    },
  },

  "custom/pacman": {
    "format": "{} ",
    "interval": 3600, // every hour
    "exec": "(checkupdates;pacman -Qm | aur vercmp) | wc -l", // # of updates
    "exec-if": "exit 0", // always run; consider advanced run conditions
    "on-click": "foot sh -c 'yay; echo Done - Press enter to exit; read'; pkill -SIGRTMIN+8 waybar", // update system
    "signal": 8,
    "tooltip": false,
  },

  "custom/mail": {
    "format": "{} ",
    "exec": "$HOME/.config/waybar/scripts/checkgmail.py",
    "interval": 120,
    "on-click": "google-chrome-stable https://mail.google.com/mail/u/0/#inbox ; pkill -SIGRTMIN+9 waybar",
    "signal": 9,
    "tooltip": false,
  },

  "hyprland/submap": {
    "format": "pon {}",
  },

  "clock": {
    "locale": "ru_RU.UTF-8",
    "tooltip-format": "<big>{:L%A}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:L%d %b, %H:%M}",
    // "format": "{:L%a, %d %b, %H:%M}",
  },

  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 1800,
    "exec": "$HOME/.config/waybar/scripts/wttr.py",
    "return-type": "json",
    "on-click": "firefox https://wttr.in/Russia,%20Tambov",
  },

  "pulseaudio": {
    "scroll-step": 10, // %, can be a float
    "reverse-scrolling": 1,
    "format": "{volume}% {icon}",
    //        "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    //        "format-source": "{volume}% ",
    //        "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
    "min-length": 8,
    //        default 13
  },

  "custom/mem": {
    "format": "{} ",
    "interval": 3,
    "exec": "free -h | awk '/Mem:/{printf $3}'",
    "tooltip": false,
  },

  "cpu": {
    "interval": 2,
    "format": "{usage}% ",
    "min-length": 6,
  },

  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    // "format-critical": "{temperatureC}°C {icon}",
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", "", "", ""],
    "tooltip": false,
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}% {icon}",
    "format-icons": [""],
    "min-length": 7,
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", "", "", "", "", "", ""],
    "on-update": "$HOME/.config/waybar/scripts/check_battery.sh",
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },
}
